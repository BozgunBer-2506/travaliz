PORT=8080
# Default: external provider links, no API key or paid searches.
SEARCH_MODE=external
# Optional legacy mode: SEARCH_MODE=serpapi; key remains server-only.
SERPAPI_API_KEY=
DB_PATH=bookings.db
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
SUPABASE_URL=https://isrbbnxgjmlkcetwguom.supabase.co
SUPABASE_SECRET_KEY=
# Disabled by default. Requires the hotel_sandbox_checkouts migration and a
# sand_/sandbox_ LiteAPI key. Production keys are always rejected for booking.
LITEAPI_SANDBOX_BOOKING_ENABLED=false
LITEAPI_API_KEY=

# B2B integration (optional); placeholder requests do not trigger operations by default.
B2B_WEBHOOK_ENABLED=false
B2B_WEBHOOK_URL=http://localhost:3000
B2B_WEBHOOK_SECRET=

# Duffel v2 sandbox token; server-only, used for flight search and test bookings.
DUFFEL_API_TOKEN=
# Live flight search is disabled by default. Enabling it requires both a flag
# and a token with the duffel_live_ prefix; create that token with Duffel's
# own "read-only" scope (dashboard, Live mode). It can never create an order:
# CreateOrder only exists on the separate sandbox client (DUFFEL_API_TOKEN).
LIVE_FLIGHT_SEARCH_ENABLED=false
DUFFEL_LIVE_API_TOKEN=
